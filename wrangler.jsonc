{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devnet-toolbox",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devnet_toolbox",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
  // Secrets (never in this file):
  //   BOT_TOKEN       — wrangler secret put BOT_TOKEN
  //   WEBHOOK_SECRET  — wrangler secret put WEBHOOK_SECRET
  //   ADMIN_SECRET    — wrangler secret put ADMIN_SECRET
}
